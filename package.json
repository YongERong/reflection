{
  "name": "reflection-bot",
  "private": true,
  "version": "0.1.0",
  "description": "Telegram reflection bot using a configurable Gibbs cycle, Better Agents conventions, and Supabase.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "dev:bot": "node --env-file=.env --import tsx apps/bot/src/server.ts",
    "dev:bot:polling": "node --env-file=.env --import tsx apps/bot/src/polling.ts",
    "dev:dashboard": "vite --host 0.0.0.0 --port 3000 --config apps/dashboard/vite.config.ts",
    "eval:reflection": "node --env-file=.env --import tsx better-agents/evals/run-reflection-evals.ts",
    "eval:sufficiency": "node --env-file=.env --import tsx better-agents/evals/run-sufficiency-evals.ts",
    "eval:bot-flow": "node --env-file=.env --import tsx better-agents/evals/run-bot-flow-evals.ts",
    "prompt:pull": "langwatch prompt pull",
    "prompt:push": "langwatch prompt push",
    "prompt:sync": "langwatch prompt sync",
    "typecheck": "tsc -b --pretty"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@grammyjs/types": "^3.16.0",
    "@langwatch/better-agents": "^0.1.23",
    "@opentelemetry/context-async-hooks": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@supabase/supabase-js": "^2.49.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fastify": "^5.2.1",
    "grammy": "^1.35.0",
    "langwatch": "^0.27.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4"
  }
}
